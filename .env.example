# Konfigurasi Aplikasi
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-random-key-yang-kuat

# Default Admin (hanya digunakan saat pertama kali setup)
DEFAULT_ADMIN_PASSWORD=Admin123!

# Path Tesseract OCR (sesuaikan dengan lokasi instalasi)
# Windows: D:\path\to\tesseract.exe
# Linux: /usr/bin/tesseract
TESSERACT_CMD=/usr/bin/tesseract

# Path Poppler (sesuaikan dengan lokasi instalasi)
# Windows: D:\path\to\poppler\Library\bin
# Linux: kosongkan (gunakan system PATH)
POPPLER_PATH=

# Database (kosongkan untuk SQLite default, isi untuk PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/plagiarism_db
